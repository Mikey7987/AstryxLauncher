<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mc_version_spinner">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingTop="@dimen/_12sdp"
            android:paddingBottom="@dimen/_10sdp">

            <TextView
                android:id="@+id/astryx_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASTRYX"
                android:textColor="@color/astryx_accent"
                android:textStyle="bold"
                android:textSize="30sp"
                android:letterSpacing="0.16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/astryx_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JAVA EDITION  •  ANDROID"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/astryx_brand"/>

            <TextView
                android:id="@+id/astryx_section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK ACCESS"
                android:textColor="@color/secondary_text"
                android:textStyle="bold"
                android:textSize="11sp"
                android:letterSpacing="0.14"
                android:layout_marginTop="@dimen/_18sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/astryx_tagline"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/AstryxMenuCard"
                android:layout_width="0dp"
                android:text="@string/mcl_tab_wiki"
                android:drawableStart="@drawable/ic_px_book"
                app:layout_constraintTop_toBottomOf="@id/astryx_section"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/social_media_button"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/social_media_button"
                style="@style/AstryxMenuCard"
                android:layout_width="0dp"
                android:text="@string/mcl_button_social_media"
                android:drawableStart="@drawable/ic_social_media"
                app:layout_constraintTop_toTopOf="@id/news_button"
                app:layout_constraintStart_toEndOf="@id/news_button"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/AstryxMenuCard"
                android:layout_width="0dp"
                android:text="@string/mcl_option_customcontrol"
                android:drawableStart="@drawable/ic_px_gamepad"
                app:layout_constraintTop_toBottomOf="@id/news_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/install_jar_button"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/AstryxMenuCard"
                android:layout_width="0dp"
                android:text="@string/main_install_jar_file"
                android:drawableStart="@drawable/ic_px_java_run"
                app:layout_constraintTop_toTopOf="@id/custom_control_button"
                app:layout_constraintStart_toEndOf="@id/custom_control_button"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/cursor_studio_button"
                style="@style/AstryxMenuCard"
                android:layout_width="0dp"
                android:text="@string/astryx_cursor_studio"
                android:drawableStart="@drawable/ic_px_edit"
                app:layout_constraintTop_toBottomOf="@id/custom_control_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/performance_button"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/performance_button"
                style="@style/AstryxMenuCard"
                android:layout_width="0dp"
                android:text="@string/astryx_performance"
                android:drawableStart="@drawable/ic_px_sliders"
                app:layout_constraintTop_toTopOf="@id/cursor_studio_button"
                app:layout_constraintStart_toEndOf="@id/cursor_studio_button"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/storage_migration_button"
                style="@style/AstryxMenuCard"
                android:layout_width="0dp"
                android:text="@string/astryx_migration"
                android:drawableStart="@drawable/ic_px_folder"
                app:layout_constraintTop_toBottomOf="@id/cursor_studio_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/share_logs_button"/>
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/AstryxMenuCard"
                android:layout_width="0dp"
                android:text="@string/main_share_logs"
                android:drawableStart="@drawable/ic_px_sharelog"
                app:layout_constraintTop_toTopOf="@id/storage_migration_button"
                app:layout_constraintStart_toEndOf="@id/storage_migration_button"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/AstryxMenuCard"
                android:layout_width="match_parent"
                android:text="@string/mcl_button_open_directory"
                android:drawableStart="@drawable/ic_px_folder"
                app:layout_constraintTop_toBottomOf="@id/storage_migration_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/_36sdp"
        android:background="@android:color/transparent"
        android:drawableEnd="@drawable/spinner_arrow"
        app:drawableEndSize="@dimen/padding_heavy"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="@dimen/_36sdp"
        app:drawableEndPadding="@dimen/_1sdp"
        app:layout_constraintBottom_toTopOf="@id/play_button"
        app:layout_constraintEnd_toStartOf="@+id/edit_profile_button"
        app:layout_constraintStart_toStartOf="parent"/>
    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_52sdp"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/ic_px_edit"
        app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner"/>
    <View
        android:id="@+id/_background_display_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/background_bottom_bar"
        android:translationZ="-1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner"/>
    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_17sdp"
        android:layout_marginBottom="@dimen/_15sdp"
        android:textAllCaps="true"
        android:text="@string/main_play"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
